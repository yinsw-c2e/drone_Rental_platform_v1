.custom-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  height: 164rpx;
  padding-bottom: 0;
  box-sizing: border-box;
  background: #ffffff;
  border-top: 1rpx solid #e1e6ef;
}

.custom-tabbar-inner {
  height: 120rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
}

.tabbar-item {
  position: relative;
  width: 120rpx;
  min-width: 0;
  height: 96rpx;
  color: #6b7a99;
  font-size: 18.5rpx;
  font-weight: 400;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tabbar-item-active {
  color: #003b8f;
}

.tabbar-icon-shell {
  position: relative;
  width: 84rpx;
  height: 64rpx;
  margin-bottom: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tabbar-badge {
  position: absolute;
  top: -10rpx;
  right: -16rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff3b30, #ff4d5e);
  color: #ffffff;
  border: 2rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  z-index: 10;
}

.tabbar-badge-text {
  color: #ffffff;
  font-size: 18rpx;
  line-height: 24rpx;
  font-weight: 900;
  text-align: center;
}

.tabbar-badge-dot {
  position: absolute;
  top: 1rpx;
  right: 5rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #ff3b30;
  border: 4rpx solid #ffffff;
  box-sizing: border-box;
  z-index: 2;
}

.tabbar-icon-img {
  display: block;
}

.tabbar-label {
  color: #6b7a99;
  font-size: 18.5rpx;
  line-height: 24.6rpx;
  font-weight: 400;
}

.tabbar-item-active .tabbar-label {
  color: #003b8f;
  font-weight: 700;
}
