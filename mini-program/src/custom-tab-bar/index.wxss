.custom-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  height: calc(66px + constant(safe-area-inset-bottom));
  height: calc(66px + env(safe-area-inset-bottom));
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 -5px 16px rgba(20, 40, 80, 0.07);
  backdrop-filter: blur(9px);
}

.custom-tabbar-inner {
  height: 66px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
}

.tabbar-item {
  position: relative;
  width: 80px;
  min-width: 0;
  height: 55px;
  color: #64748b;
  font-size: 11px;
  font-weight: 700;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tabbar-item-active {
  color: #1f6bff;
}

.tabbar-icon-shell {
  position: relative;
  width: 27px;
  height: 27px;
  margin-bottom: 2px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tabbar-badge {
  position: absolute;
  top: -6px;
  right: -10px;
  min-width: 18px;
  height: 16px;
  padding: 0 4px;
  border-radius: 999px;
  background: linear-gradient(135deg, #ff3045, #ff4d5e);
  color: #ffffff;
  border: 2px solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  z-index: 2;
}

.tabbar-badge-text {
  color: #ffffff;
  font-size: 9px;
  line-height: 12px;
  font-weight: 900;
}

.tabbar-icon-img {
  width: 27px;
  height: 27px;
  display: block;
}

.tabbar-label {
  color: #64748b;
  font-size: 11px;
  line-height: 15px;
  font-weight: 700;
}

.tabbar-item-active .tabbar-label {
  color: #1f6bff;
  font-weight: 800;
}
