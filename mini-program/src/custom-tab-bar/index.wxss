.custom-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: #ffffff;
  border-top: 1px solid #edf0f4;
  box-shadow: 0 -2px 10px rgba(15, 23, 42, 0.04);
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.custom-tabbar-inner {
  height: 60px;
  display: flex;
  flex-direction: row;
}

.tabbar-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8b94a3;
}

.tabbar-item-active {
  color: #2563eb;
}

.tabbar-icon-shell {
  width: 38px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 2px;
  border-radius: 16px;
  background: transparent;
}

.tabbar-item-active .tabbar-icon-shell {
  background: #eff6ff;
}

.tabbar-icon {
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tabbar-label {
  font-size: 13px;
  line-height: 17px;
  font-weight: 600;
  color: #8b94a3;
}

.tabbar-item-active .tabbar-label {
  color: #2563eb;
  font-weight: 700;
}

.home-panel {
  position: relative;
  width: 22px;
  height: 22px;
  border: 1px solid #8b94a3;
  border-radius: 7px;
  box-sizing: border-box;
}

.home-panel-line {
  position: absolute;
  background: #8b94a3;
  border-radius: 999px;
}

.home-panel-line-v {
  top: 4px;
  bottom: 4px;
  left: 50%;
  width: 1px;
  transform: translateX(-50%);
}

.home-panel-line-h {
  left: 4px;
  right: 4px;
  top: 50%;
  height: 1px;
  transform: translateY(-50%);
}

.tabbar-item-active .home-panel {
  border-color: #2563eb;
}

.tabbar-item-active .home-panel-line {
  background: #2563eb;
}

.message-bubble {
  position: relative;
  width: 23px;
  height: 17px;
  border: 1px solid #8b94a3;
  border-radius: 7px;
  box-sizing: border-box;
}

.message-line {
  width: 9px;
  height: 1px;
  margin-left: 5px;
  margin-top: 3px;
  border-radius: 999px;
  background: #8b94a3;
}

.message-line-long {
  width: 13px;
  margin-top: 4px;
}

.message-tail {
  position: absolute;
  left: 6px;
  bottom: -4px;
  width: 7px;
  height: 7px;
  border-left: 1px solid #8b94a3;
  border-bottom: 1px solid #8b94a3;
  background: #ffffff;
  transform: rotate(-28deg);
  box-sizing: border-box;
}

.tabbar-item-active .message-bubble {
  border-color: #2563eb;
}

.tabbar-item-active .message-line {
  background: #2563eb;
}

.tabbar-item-active .message-tail {
  border-color: #2563eb;
}

.profile-icon {
  flex-direction: column;
}

.profile-head {
  width: 9px;
  height: 9px;
  border: 1px solid #8b94a3;
  border-radius: 50%;
  box-sizing: border-box;
}

.profile-body {
  width: 20px;
  height: 10px;
  margin-top: 3px;
  border: 1px solid #8b94a3;
  border-radius: 12px 12px 6px 6px;
  box-sizing: border-box;
}

.tabbar-item-active .profile-head,
.tabbar-item-active .profile-body {
  border-color: #2563eb;
  background: transparent;
}
