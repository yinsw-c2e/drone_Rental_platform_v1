# H5 网页版本地配置模板。
# 复制为 .env.h5.local（已在 .gitignore 中忽略），填入你的高德 Key 后运行 `npm run dev:h5`。

# 高德地图 Web 端 (JS API) Key —— 用于实时轨迹地图 + 可拖拽选点。
# 申请：https://console.amap.com/dev/key/app （服务平台选「Web端(JS API)」）
H5_AMAP_KEY=

# JS API 2.0 安全密钥（与 Key 配套，在控制台 Key 详情页获取）。1.x 可留空。
H5_AMAP_SECURITY_CODE=

# 后端地址（默认本地 http://127.0.0.1:8080/api/v2，已对 localhost:3000 放行 CORS）。
# 如需指向线上隧道可改为：https://dronerentalplat.cpolar.top/api/v2
# MINI_PROGRAM_API_BASE=http://127.0.0.1:8080/api/v2
